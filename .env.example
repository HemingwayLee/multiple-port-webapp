# Copy to .env. Docker Compose reads .env automatically; every value below has a dev default.

# Postgres superuser (used only by db-init to create the per-app databases).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Per-app database passwords (role name = database name). Use URL-safe characters: they go into DATABASE_URL.
APP1_DB_PASSWORD=app1
APP2_DB_PASSWORD=app2

# Hostname for the self-signed dev certificate (ignored if nginx/certs already has one).
CERT_HOSTNAME=localhost

# Host ports.
HTTP_PORT=80
HTTPS_PORT=443
DB_HOST_PORT=5432
